# ============================================================
#  TRADING BARA MAIL — configuration de PRODUCTION (/opt/tradingbara-mail/.env)
#  Copié par :  cp deploy/env.production.example .env && chmod 600 .env
#  Les valeurs SECRÈTES se saisissent directement sur le serveur (nano .env), jamais ailleurs.
# ============================================================

SITE_URL=https://mail.tradingbara.uk

# Généré par la commande sed de la procédure (64 caractères aléatoires) — SECRET
SESSION_SECRET=

# Double authentification à la connexion (fortement recommandée : l'interface envoie au nom de Trading Bara)
LOGIN_2FA=on
SESSION_HOURS=12
SENDS_PER_HOUR=60

# Zoho Mail Europe (SSL, port 465)
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@tradingbara.uk
# Mot de passe d'APPLICATION Zoho — SECRET
SMTP_PASS=
MAIL_FROM=Trading Bara <contact@tradingbara.uk>
# MAIL_REPLY_TO=

# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels → ton tunnel) — SECRET
TUNNEL_TOKEN=
